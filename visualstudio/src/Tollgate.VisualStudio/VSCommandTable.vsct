      <IDSymbol name="TollgateMenu" value="0x1000" />
      <IDSymbol name="ToolsMenuGroup" value="0x1100" />
      <IDSymbol name="RunGroup" value="0x1101" />
      <IDSymbol name="HooksGroup" value="0x1102" />
      <IDSymbol name="ConfigGroup" value="0x1103" />
      <IDSymbol name="ShowWindow" value="0x0100" />
      <IDSymbol name="RunChecks" value="0x0101" />
      <IDSymbol name="RunAllFiles" value="0x0102" />
      <IDSymbol name="RunPrePush" value="0x0103" />
      <IDSymbol name="InstallHooks" value="0x0104" />
      <IDSymbol name="UninstallHooks" value="0x0105" />
      <IDSymbol name="OpenConfig" value="0x0106" />
      <IDSymbol name="TogglePause" value="0x0107" />
      <IDSymbol name="FixWhitespace" value="0x0108" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
