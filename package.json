  "scripts": {
    "schema": "node scripts/schema.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p .",
    "build": "npm run schema && node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "vscode:prepublish": "npm run schema && node scripts/build.js --production",
    "pretest": "npm run build && tsc -p .",
    "test": "node --test --test-concurrency=1 out/test/core.test.js out/test/e2e.test.js && node test/smoke.js",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.85",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "5.6"
  }
