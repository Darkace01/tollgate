        "precommitGuard.custom": {
          "type": "array",
          "description": "Your own checks: any shell command. Placeholders: {files} (matching staged files), {root}, {branch}, {msgFile}, {stagedCount}.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable id (used by SKIP=). Defaults to a slug of the name."
              },
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string",
                "description": "Shell command, e.g. \"npx eslint --max-warnings 0 {files}\"."
              },
              "glob": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "description": "Only run when staged files match; {files} is filtered to these."
              },
              "stage": {
                "type": "string",
                "enum": [
                  "pre-commit",
                  "commit-msg",
                  "pre-push"
                ],
                "default": "pre-commit"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ],
                "description": "`error` blocks the commit, `warning` only reports.",
                "default": "error"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "cwd": {
                "type": "string",
                "description": "Working directory relative to repo root."
              },
              "timeoutSec": {
                "type": "number",
                "minimum": 1,
                "default": 300
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "alwaysRun": {
                "type": "boolean",
                "description": "Run even when no staged file matches."
              },
              "restage": {
                "type": "boolean",
                "description": "Re-stage files changed by this command (formatters with --write/--fix)."
              }
            }
          },
          "default": [],
          "order": 10,
          "markdownDescription": "Custom command checks. Example: `{ \"name\": \"Prettier\", \"command\": \"npx prettier --check {files}\", \"glob\": \"**/*.{ts,tsx}\" }`",
          "scope": "resource"
        },
        "precommitGuard.autoInstallHooks": {
          "type": "string",
          "enum": [
            "prompt",
            "always",
            "never"
