<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Tollgate.VisualStudio.KazeemQuadri" Version="1.2.0" Language="en-US" Publisher="Kazeem Quadri" />
    <DisplayName>Tollgate — Pre-Commit Checks for Visual Studio</DisplayName>
    <Description xml:space="preserve">Pre-commit checks that just work for C# and .NET: dotnet format, dotnet build and CSharpier on staged files, plus secrets, debug code, conflict markers, large and forbidden files, and commit message rules. Results in a Tollgate window and the Error List.</Description>
    <MoreInfo>https://github.com/Darkace01/tollgate</MoreInfo>
    <License>Resources\LICENSE.txt</License>
    <ReleaseNotes>https://github.com/Darkace01/tollgate/blob/main/CHANGELOG.md</ReleaseNotes>
    <Icon>Resources\Icon.png</Icon>
    <PreviewImage>Resources\Icon.png</PreviewImage>
    <Tags>pre-commit, git hooks, C#, dotnet format, csharpier, lint, secrets, commit message</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.8,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
